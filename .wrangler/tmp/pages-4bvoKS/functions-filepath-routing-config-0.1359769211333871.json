{
  "routes": [
    {
      "routePath": "/api/days/:id",
      "mountPath": "/api/days",
      "method": "DELETE",
      "module": [
        "api/days/[id].js:onRequestDelete"
      ]
    },
    {
      "routePath": "/api/days/:id",
      "mountPath": "/api/days",
      "method": "PUT",
      "module": [
        "api/days/[id].js:onRequestPut"
      ]
    },
    {
      "routePath": "/api/days",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/days.js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/days",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/days.js:onRequestPost"
      ]
    }
  ],
  "baseURL": "/"
}